            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"code\": \"DESCUENTO20\",\n    \"type\": \"PERCENTAGE\",\n    \"value\": 20,\n    \"minAmount\": 50,\n    \"maxUses\": 100,\n    \"expiresAt\": \"2026-12-31T23:59:59Z\",\n    \"isActive\": true,\n    \"dropIds\": [\"{{dropId}}\"]\n}",
